# Copy this file to .env.local and fill in. Never commit .env.local.

# mock (default) or live. live needs QLOO_API_KEY.
QLOO_MODE=mock
QLOO_API_KEY=
# Leave empty for https://api.qloo.com. Hackathon keys use https://hackathon.api.qloo.com.
# Check the key and address with: npm run qloo:check
QLOO_API_URL=
# Max Qloo calls per exploration
QLOO_CALL_BUDGET=40
# Live Qloo: per-request timeout, retries on 429/5xx/timeouts, and how long
# identical requests are answered from memory (0 = no cache).
QLOO_TIMEOUT_MS=10000
QLOO_RETRIES=2
QLOO_CACHE_TTL_MS=21600000
# Optional: override the Qloo tag id of a category (the real ids are in
# src/lib/agent/categories.ts). Example:
# QLOO_CATEGORY_TAGS=malatang=urn:tag:...,bubble_tea=urn:tag:...
QLOO_CATEGORY_TAGS=

# Optional: Google Maps cross-check (Places API (New)). Only used with QLOO_MODE=live.
# Asks only for place ids, Google's free "Text Search Essentials (IDs Only)" tier.
# Check the key with: npm run google:check
GOOGLE_MAPS_API_KEY=
# Max Google Maps requests (result pages) per exploration
GOOGLE_CALL_BUDGET=24
# Max Google Maps requests per day (per server instance)
GOOGLE_DAILY_LIMIT=300

# mock (default): fixed pipeline, no model. claude: Claude decides which
# Qloo lookups to make (needs ANTHROPIC_API_KEY with credit).
LLM_MODE=mock
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best reasoning), claude-sonnet-5-5 (about half the price),
# claude-haiku-5-5 (by far the cheapest; good for day-to-day testing)
ANTHROPIC_MODEL=claude-opus-5-5

# Stop starting new lookups after this many ms (the run then finishes with what it has).
EXPLORE_TIME_BUDGET_MS=150000
# Pause per mock Qloo call, so a mock run is slow enough to follow on screen.
MOCK_DELAY_MS=350

# Public demo protection: explorations running at once, and per visitor per hour
# (the hourly limit only applies in production). Both are kept in memory, so on Vercel
# they hold per server instance, not globally. The real global cap on spend is:
#   - spend limits set at the providers (Anthropic workspace limit, Qloo quota,
#     Google Cloud quota on the Maps key), and
#   - a Vercel Firewall rate-limit rule on /api/explore.
# Set both before the demo is public.
EXPLORE_MAX_CONCURRENT=3
EXPLORE_RUNS_PER_IP_PER_HOUR=20

# Recorded-run fallback (src/data/replays/). A visitor turned away by the limits above, or
# whose live run fails before it finds anything, sees the city's recorded run, labelled.
# 1 = every exploration plays the recording instead of running live (testing, or an
# emergency switch); a city with no recording then answers 503.
EXPLORE_FORCE_REPLAY=
# Kill switch: false = no live runs at all, every exploration plays the city's recording
# (same as EXPLORE_FORCE_REPLAY=1). Flip it in the Vercel dashboard and redeploy if spend
# runs away. Unset or true = live runs on.
EXPLORE_LIVE_ENABLED=
# Seconds a recorded run takes to play back (never slower than it ran live; 0 = at once).
EXPLORE_REPLAY_SECONDS=20
